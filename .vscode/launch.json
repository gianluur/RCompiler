            "cargo": {
                "args": [
                    "run",
                    "--bin=rcompiler",
                ]
            },
            "args": ["compiler/input.grc"],
            
        },
        {
            "name": "Debug unit tests in executable 'rcompiler'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=rcompiler"
                ]
            }
        },
        {
            "name": "Debug integration test 'tests'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--test=tests"
                ]
            }
        }
    ]
